---
import ArticleLink from '@/components/article-link.astro';
import Base from '@/layouts/base.astro';
import type { Frontmatter } from '@/utils/article-types';
import type { MDXInstance } from 'astro';
import { embeddedMarkdownToHtml } from '@/utils/embedded-markdown';
import { allArticlesButHidden } from '@/utils/article-utils';

interface Props {
  posts: MDXInstance<Frontmatter>[];
  tag: string;
}

export async function getStaticPaths() {
  const allTags: Set<string> = new Set(
    allArticlesButHidden
      .flatMap((article) => article.frontmatter.tags)
      .filter((v) => v),
  );

  return [...allTags].map((tag) => ({
    params: { id: tag },
    props: {
      posts: allArticlesButHidden.filter(
        (post) => post.frontmatter?.tags?.includes(tag) || false,
      ),
      tag: tag,
    },
  }));
}

const tagMap: Record<string, string> = {
  guide: 'Little hand written guides for your consumption pleasure!',
  pterodactyl:
    'For the [pterodactyl](https://pterodactyl.io/) management panel',
  programming: 'All things programming go here!',
};

const { posts, tag } = Astro.props;

const preamble = embeddedMarkdownToHtml(`# Articles tagged "${tag}"
### ${posts.length} ${posts.length > 1 ? 'articles' : 'article'} found
${tagMap[tag] ?? ''}`);
---

<Base pageTitle={`Tag: "${tag}"`} ogDescription={`Articles tagged with "${tag}"`}>
  <div
    class={`
      article tight-markdown prose mx-auto w-full pb-4
      xl:prose-lg
      dark:prose-invert
    `}
    set:html={preamble}
  />
  <div class="flex flex-col gap-4">
    {posts.map((post) => <ArticleLink article={post} />)}
  </div>
  <div class="text-subtext0/50 py-16 text-center italic">With perhaps more to come...</div>
</Base>
