---
import Base from '@/layouts/base.astro';
import { embeddedMarkdownToHtml } from '@/utils/embedded-markdown';
import Tag from '@/assets/icons/tag.svg?raw';
import ChevronRight from '@/assets/icons/chevron-right.svg?raw';
import { allArticlesButHidden } from '@/utils/article-utils';

const tagFrequency = allArticlesButHidden
  .flatMap((post) => post.frontmatter.tags)
  .reduce<Record<string, number>>((map, tagName) => {
    map[tagName] = (map[tagName] ?? 0) + 1;
    return map;
  }, {});

const frequencyTag = Object.entries(tagFrequency).reduce<
  Record<number, string[]>
>((map, [tag, frequency]) => {
  map[frequency] = [...(map[frequency] ?? []), tag].sort();
  return map;
}, {});

const allFrequencies = Object.keys(frequencyTag)
  .map((v) => parseInt(v))
  .sort()
  .reverse();

const preamble = embeddedMarkdownToHtml(`
# All Tags
Just a list of the tags on here.`);
---

<Base pageTitle="All Tags" ogDescription="Tag listing">
  <div
    class={`
      article tight-markdown prose mx-auto w-full pb-4
      xl:prose-lg
      dark:prose-invert
    `}
    set:html={preamble}
  />
  <div class="flex flex-col gap-4">
    {
      allFrequencies
        .map((frequency) =>
          frequencyTag[frequency].map((tag) => (
            <a
              class={`
                from-surface0/20 to-surface1/40 outline-surface1/70 text-text flex justify-between
                rounded bg-radial from-80% px-4 py-2 text-nowrap outline-1 transition-colors
                hover:bg-surface1
              `}
              href={`/tags/${tag}`}
            >
              <span class="flex flex-row items-center gap-4">
                <span class="text-subtext1/60" set:html={Tag} />
                {tag}
              </span>
              <span class="flex flex-row items-center gap-2">
                <span class="text-subtext1">{frequency}</span>
                <span set:html={ChevronRight} />
              </span>
            </a>
          )),
        )
        .flat()
    }
  </div>
</Base>
