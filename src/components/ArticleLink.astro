---
import type { Frontmatter } from '@/utils/article-types';
import { extractFilePathData } from '@/utils/article-utils';
import { embeddedMarkdownToHtml, stripOutsideTags } from '@/utils/embedded-markdown';
import type { MDXInstance } from 'astro';
interface Props {
  article: MDXInstance<Frontmatter>;
}

const { article } = Astro.props;
const { date, title } = extractFilePathData(article.file);

const frontmatter = article.frontmatter;

const renderedTitle = stripOutsideTags(embeddedMarkdownToHtml(frontmatter.title));
const renderedSubtitle = embeddedMarkdownToHtml(frontmatter.description);
---

<div
  class={`
    article-link prose prose-linked outline-subtext1/30 from-surface0/10 to-surface0/30 mx-auto
    w-full rounded-xl from-50% p-4 shadow-md outline-1 transition-colors duration-300
    hover:outline-hotpink hover:bg-radial hover:shadow-lg
    xl:prose-lg
    dark:prose-invert
  `}
>
  <a
    href={`/article/${title}`}
    class={`
      w-full text-left
      rtl:text-right
    `}
  >
    <div class="embedded-markdown text-subtext1" set:html={renderedSubtitle} />
    <span class="block w-full">
      <span
        class="article-title embedded-markdown text-2xl !font-medium"
        set:html={renderedTitle}
      />
    </span>
    <p class="text-subtext0 !my-0">
      <span data-date={date}>
        {
          new Date(date).toLocaleDateString('en-us', {
            timeZone: 'UTC',
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })
        }
      </span>
      ∙
      <span>{frontmatter.readingTime}</span>
    </p>
  </a>
  {
    article.frontmatter.tags && (
      <>
        <hr class="!my-2" />
        <div class="not-prose no-scrollbar flex w-full flex-row gap-4 overflow-scroll p-1 pt-2">
          {(article.frontmatter?.tags || []).map((tag) => (
            <a
              class={`
                from-surface0/30 to-surface1/30 outline-surface1/70 flex flex-row gap-2
                rounded-l-3xl rounded-r-lg bg-radial from-40% px-2 text-nowrap outline-1
                transition-colors
                hover:bg-surface1 hover:outline-surface1
              `}
              href={`/tags/${tag}`}
              tabindex="-1"
              title={tag}
            >
              <span class="text-surface2 select-none">•</span> {tag}
            </a>
          ))}
        </div>
      </>
    )
  }
</div>
