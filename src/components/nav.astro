---
import SunMoon from '@/assets/icons/sun-moon.svg?raw';
import Tags from '@/assets/icons/tags.svg?raw';
---

<div class="flex justify-between py-6 text-2xl">
  <a href="/" title="Home">
    <img alt="logo" src="/favicon.svg" class="inline-block w-12 select-none" />
  </a>
  <div
    class={`
      text-overlay0 flex items-center gap-4
      print:!hidden
    `}
  >
    <a
      class={`
        hover:text-text
        transition-colors duration-200
      `}
      href="/tags"
      title="All tags"
      set:html={Tags}
    />
    <button
      id="theme-switcher"
      class={`
        hover:text-text
        transition-colors duration-200
        noscript:hidden
      `}
      aria-label="Theme Switcher (System)"
      title="System"
      set:html={SunMoon}
    />
  </div>
</div>
